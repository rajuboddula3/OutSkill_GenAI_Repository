# ---- Week2 ignores (patterns are relative to Week2/) ----

# Virtual environments
# .venv/     -> uv-managed env (`uv sync`), CPython 3.12 per .python-version
# venv/      -> plain `python3 -m venv venv` env described in README.md
.venv/
venv/
env/
week2_env/

# Secrets — never commit (README.md "Important Security Notes")
# Day_1/.env holds HF_TOKEN
.env
.env.*
**/.env
!.env.example

# Python bytecode / tool caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Downloaded HuggingFace models + their metadata json
# Day_1/models/{bart-large-cnn,bart-large-mnli,bert-base-...,distilbert-...}
models/
**/models/
.cache/
huggingface/

# Model artifacts written by the notebooks
# Day_1/scaler.pkl, tabpfn_air_passengers_model.pkl, tabpfn_breast_cancer_model.pkl
*.pkl
*.joblib
*.pt
*.safetensors

# Notebook-generated data (Day_1/air_passengers_supervised.csv)
Day_1/air_passengers_supervised.csv

# Images generated by the Day_2 diffusion notebooks
*.png
*.jpg
*.jpeg

# Streamlit local secrets (chatbot.py / search_ui.py)
.streamlit/secrets.toml

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# ---- Explicitly kept (uv reproducibility) ----
!pyproject.toml
!uv.lock
!.python-version
!requirements.txt
